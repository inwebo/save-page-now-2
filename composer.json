{
    "name": "inwebo/save-page-now-2",
    "description": "Capture a web page as it appears now for use as a trusted citation in the future.",
    "type": "library",
    "keywords": [ "internet archive", "save page now 2", "spn2" ],
    "homepage": "https://github.com/inwebo/save-page-now-2",
    "version": "1.0.0",
    "require": {
        "php": "^8.1",
        "symfony/http-client": "^7.4|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "friendsofphp/php-cs-fixer": "^3.91",
        "phpstan/phpstan": "^2.1"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Inwebo\\SavePageNow2\\": "src/"
        }
    },
    "autoload-dev": {
      "psr-4": {
        "Inwebo\\SavePageNow2\\Tests\\": "tests/"
      }
    },
    "authors": [
      {
        "name": "Inwebo Veritas",
        "email": "github@inwebo.net",
        "homepage": "https://www.inwebo.net",
        "role": "Developer"
      }
    ],
    "minimum-stability": "stable",
    "scripts": {
      "php-cs-fixer": "vendor/bin/php-cs-fixer --allow-risky=yes fix",
      "phpunit": "XDEBUG_MODE=coverage vendor/bin/phpunit --testdox",
      "phpstan": "vendor/bin/phpstan analyse src -c phpstan.neon"
    }
}
